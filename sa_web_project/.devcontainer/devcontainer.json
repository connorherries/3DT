{
  "name": "Sports Analytics Learning Hub",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [5000, 8080, 3306],
  "portsAttributes": {
    "5000": {"label": "Sports Analytics Website", "onAutoForward": "openBrowser"},
    "8080": {"label": "phpMyAdmin", "onAutoForward": "openBrowser"},
    "3306": {"label": "MySQL"}
  },
  "postCreateCommand": "python -m pip install -r requirements.txt"
}
